# -------------------------------------------------------------
# Django Security & Core Settings
# -------------------------------------------------------------
SECRET_KEY=django-insecure-your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# -------------------------------------------------------------
# Google OAuth 2.0 (Social Sign-in)
# -------------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
# Must match authorized redirect URI in Google Cloud Console
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/accounts/google/callback/

# -------------------------------------------------------------
# Nova AI (Gemini Assistant)
# -------------------------------------------------------------
# Optional: enables the student-only Nova AI feature
GEMINI_API_KEY=your-gemini-api-key-here

# -------------------------------------------------------------
# Email Delivery Configuration (Password Reset & Notifications)
# -------------------------------------------------------------
# In local development without an external provider, use the console backend:
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# To send live emails, set:
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# --- Option A: Gmail SMTP (via Google App Password) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_16_char_google_app_password
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=HostelHub <your_email@gmail.com>

# --- Option B: Brevo (formerly Sendinblue) - Free tier (300 emails/day) ---
# EMAIL_HOST=smtp-relay.brevo.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your_brevo_account_login@example.com
# EMAIL_HOST_PASSWORD=your_brevo_smtp_master_key
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# DEFAULT_FROM_EMAIL=HostelHub <your_verified_sender@domain.com>

# --- Option C: Resend (SMTP) - Free tier (100 emails/day) ---
# EMAIL_HOST=smtp.resend.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=resend
# EMAIL_HOST_PASSWORD=re_your_resend_api_key
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# DEFAULT_FROM_EMAIL=HostelHub <onboarding@resend.dev>
